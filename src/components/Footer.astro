---
import { featuredServiceLinks } from '../data/servicePages';

const currentYear = new Date().getFullYear();

const serviceLinks = featuredServiceLinks.slice(0, 4);
---

<footer class="relative bg-gradient-to-b from-warm-900 via-warm-950 to-warm-950 text-warm-300 overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-copper-500/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-1/4 w-64 h-64 bg-warm-700/10 rounded-full blur-3xl"></div>
  
  <!-- Decorative top border -->
  <div class="h-px bg-gradient-to-r from-transparent via-copper-500/40 to-transparent"></div>
  
  <div class="relative max-w-6xl mx-auto px-6 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-copper-400/20 to-copper-600/20 flex items-center justify-center backdrop-blur-sm border border-copper-500/20">
            <svg class="w-5 h-5 text-copper-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7l2 13h16l2-13L12 2zm0 3l6.5 4L17 17H7l-1.5-8L12 5z"/>
            </svg>
          </div>
          <span class="font-serif text-2xl font-medium text-warm-100 tracking-wide">
            Loris Lazulis
          </span>
        </div>
        <p class="mt-6 text-sm text-warm-300 leading-relaxed max-w-xs">
          Accompagnement indépendant pour l'achat de pierres naturelles certifiées.
        </p>
        <div class="mt-8 flex gap-4">
          <div class="w-8 h-8 rounded-lg bg-warm-800/50 flex items-center justify-center hover:bg-copper-500/20 transition-colors duration-300 cursor-pointer">
            <svg class="w-4 h-4 text-warm-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-xs font-semibold text-copper-400 uppercase tracking-widest mb-6">
          Navigation
        </h3>
        <ul class="space-y-4">
          <li><a href="/" class="group text-sm text-warm-300 hover:text-warm-100 inline-flex items-center gap-2 transition-all duration-300"><span class="w-0 h-px bg-copper-400 group-hover:w-3 transition-all duration-300"></span>Accueil</a></li>
          <li><a href="/services" class="group text-sm text-warm-300 hover:text-warm-100 inline-flex items-center gap-2 transition-all duration-300"><span class="w-0 h-px bg-copper-400 group-hover:w-3 transition-all duration-300"></span>Services</a></li>
          <li><a href="/comment-je-travaille" class="group text-sm text-warm-300 hover:text-warm-100 inline-flex items-center gap-2 transition-all duration-300"><span class="w-0 h-px bg-copper-400 group-hover:w-3 transition-all duration-300"></span>Comment je travaille</a></li>
          <li><a href="/honoraires" class="group text-sm text-warm-300 hover:text-warm-100 inline-flex items-center gap-2 transition-all duration-300"><span class="w-0 h-px bg-copper-400 group-hover:w-3 transition-all duration-300"></span>Honoraires</a></li>
          <li><a href="/a-propos" class="group text-sm text-warm-300 hover:text-warm-100 inline-flex items-center gap-2 transition-all duration-300"><span class="w-0 h-px bg-copper-400 group-hover:w-3 transition-all duration-300"></span>À propos</a></li>
          <li><a href="/blog" class="group text-sm text-warm-300 hover:text-warm-100 inline-flex items-center gap-2 transition-all duration-300"><span class="w-0 h-px bg-copper-400 group-hover:w-3 transition-all duration-300"></span>Blog</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-xs font-semibold text-copper-400 uppercase tracking-widest mb-6">
          Aides prioritaires
        </h3>
        <ul class="space-y-4">
          {serviceLinks.map((post) => (
            <li>
              <a href={post.href} class="group text-sm text-warm-300 hover:text-warm-100 inline-flex items-center gap-2 transition-all duration-300">
                <span class="w-0 h-px bg-copper-400 group-hover:w-3 transition-all duration-300"></span>
                {post.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-xs font-semibold text-copper-400 uppercase tracking-widest mb-6">
          Contact
        </h3>
        <p class="text-sm text-warm-300 leading-relaxed">
          Pour toute demande d'accompagnement, utilisez le formulaire de contact.
        </p>
        <a 
          href="/contact" 
          class="group inline-flex items-center mt-6 px-5 py-2.5 text-sm font-medium text-copper-300 bg-copper-500/10 hover:bg-copper-500/20 rounded-full border border-copper-500/20 hover:border-copper-500/40 transition-all duration-300"
        >
          <span>Présenter mon projet</span>
          <svg class="ml-2 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-warm-800/30">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-xs text-warm-400">
          © {currentYear} Loris Lazulis. Tous droits réservés.
        </p>
        <div class="flex gap-8">
          <a href="/mentions-legales" class="text-xs text-warm-400 hover:text-copper-400 transition-colors duration-300">
            Mentions légales
          </a>
          <a href="/confidentialite" class="text-xs text-warm-400 hover:text-copper-400 transition-colors duration-300">
            Confidentialité
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
