---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "À propos de Loris Lazulis",
  "url": "https://loris-lazulis.com/a-propos/",
  "mainEntity": {
    "@type": "ProfessionalService",
    "name": "Loris Lazulis",
    "description": "Accompagnement indépendant avant achat de pierres naturelles certifiées.",
    "areaServed": "France",
    "serviceType": "Conseil et accompagnement indépendant avant achat de pierre précieuse"
  }
};
---

<BaseLayout
  title="À propos de Loris Lazulis"
  description="À propos de Loris Lazulis : accompagnement indépendant avant achat de pierre précieuse, sans stock, sans commission vendeur et avec limites claires."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <section class="relative py-24 md:py-28 overflow-hidden">
    <div class="absolute inset-0 gradient-warm"></div>
    <div class="relative max-w-6xl mx-auto px-6">
      <div class="max-w-3xl" data-animate>
        <span class="inline-block px-4 py-2 bg-copper-100 rounded-full text-copper-700 text-sm font-medium mb-6">
          À propos
        </span>
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-warm-900 font-medium leading-tight">
          Un accompagnement indépendant, pas une vente de pierres
        </h1>
        <p class="mt-8 text-xl text-warm-800 leading-relaxed">
          J'aide des particuliers à mieux décider avant l'achat d'une pierre précieuse : comprendre les documents, questionner les annonces, évaluer les risques et refuser les dossiers trop flous.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="prose prose-lg prose-warm max-w-none prose-headings:font-serif prose-headings:font-medium" data-animate>
        <h2>Ma position</h2>
        <p>
          Mon intervention part d'un constat simple : un acheteur non spécialiste se retrouve souvent face à des informations incomplètes. Le vendeur connaît son produit, le laboratoire décrit la pierre, mais personne ne traduit toujours ces éléments en décision pratique pour l'acheteur.
        </p>
        <p>
          Je travaille comme tiers indépendant côté acheteur. Je ne possède pas de stock, je ne vends pas de pierres et je ne touche pas de commission vendeur. Cette indépendance permet de recommander d'attendre, de demander une re-certification ou de ne pas acheter.
        </p>

        <h2>Ce que je fais</h2>
        <p>
          J'analyse les projets d'acquisition : certificats gemmologiques, annonces, cohérence du prix, traitements, provenance annoncée, qualité du vendeur, conditions de transaction et questions à poser avant paiement.
        </p>
        <p>
          Mon rôle consiste à organiser l'information disponible. Une décision d'achat reste personnelle : beauté de la pierre, usage, budget, goût et tolérance au risque ne peuvent pas être automatisés.
        </p>

        <h2>Ce que je ne prétends pas faire</h2>
        <p>
          Je ne remplace pas un laboratoire gemmologique, je ne produis pas d'expertise physique officielle et je ne garantis pas une valeur future. Une pierre précieuse n'est pas un placement garanti, même lorsqu'elle est rare ou bien certifiée.
        </p>
        <p>
          Lorsque la documentation est insuffisante, que le vendeur refuse un cadre raisonnable ou que la demande repose sur une promesse irréaliste, je préfère refuser le dossier.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-sand rounded-[3rem] mx-4">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white p-7 rounded-2xl border border-warm-200 shadow-warm" data-animate>
          <h2 class="font-serif text-2xl text-warm-900 font-medium">Indépendance</h2>
          <p class="mt-4 text-warm-800 leading-relaxed">
            Aucun stock, aucune pierre à pousser, aucune commission vendeur. Le conseil doit rester aligné sur l'intérêt de l'acheteur.
          </p>
        </div>
        <div class="bg-white p-7 rounded-2xl border border-warm-200 shadow-warm" data-animate>
          <h2 class="font-serif text-2xl text-warm-900 font-medium">Méthode</h2>
          <p class="mt-4 text-warm-800 leading-relaxed">
            Certificat, annonce, vendeur, prix, traitement, provenance et conditions sont regardés ensemble, jamais isolément.
          </p>
        </div>
        <div class="bg-white p-7 rounded-2xl border border-warm-200 shadow-warm" data-animate>
          <h2 class="font-serif text-2xl text-warm-900 font-medium">Limites</h2>
          <p class="mt-4 text-warm-800 leading-relaxed">
            Je préfère une limite claire à une promesse excessive. Certaines incertitudes restent normales dans ce marché.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="relative overflow-hidden bg-gradient-to-br from-warm-100 via-copper-50 to-warm-100 rounded-[2.5rem] p-10 md:p-16 text-center" data-animate>
        <h2 class="font-serif text-3xl md:text-4xl text-warm-900 font-medium">
          Vous avez un projet concret ?
        </h2>
        <p class="mt-5 text-lg text-warm-800 max-w-2xl mx-auto leading-relaxed">
          Envoyez les grandes lignes, le budget, le type de pierre et les documents disponibles. Je vous dirai si je peux vous aider utilement.
        </p>
        <div class="mt-10">
          <CTA text="Présenter mon projet" variant="copper" size="large" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
