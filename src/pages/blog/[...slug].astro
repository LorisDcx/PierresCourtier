---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { featuredServiceLinks } from '../../data/servicePages';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Schema.org BlogPosting structured data
const schemaBlogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "url": canonicalURL.href,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
  "author": {
    "@type": "Organization",
    "name": "Loris Lazulis"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Loris Lazulis"
  }
};

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('fr-FR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}
---

<BaseLayout 
  title={post.data.title}
  description={post.data.description}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaBlogPosting)} />
  <article>
    <!-- Header -->
    <header class="py-24 bg-gradient-to-b from-warm-100 to-cream">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-3xl">
          {post.data.category && (
            <span class="inline-block px-3 py-1 text-xs font-medium text-copper-700 bg-copper-100 rounded-full uppercase tracking-wider">
              {post.data.category}
            </span>
          )}
          <h1 class="mt-4 font-serif text-3xl md:text-4xl lg:text-5xl text-warm-900 font-medium leading-tight">
            {post.data.title}
          </h1>
          <p class="mt-6 text-xl text-warm-700 leading-relaxed">
            {post.data.description}
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-warm-700">
            <time datetime={post.data.pubDate.toISOString()}>
              Publié le {formatDate(post.data.pubDate)}
            </time>
            {post.data.updatedDate && post.data.updatedDate.getTime() !== post.data.pubDate.getTime() && (
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Mis à jour le {formatDate(post.data.updatedDate)}
              </span>
            )}
          </div>
        </div>
      </div>
    </header>

    <!-- Content -->
    <div class="py-16 bg-cream">
      <div class="max-w-3xl mx-auto px-6">
        <div class="prose prose-lg max-w-none
          prose-headings:font-serif prose-headings:font-medium prose-headings:text-warm-900
          prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6
          prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
          prose-p:leading-relaxed prose-p:text-warm-800
          prose-li:text-warm-800
          prose-strong:text-warm-900 prose-strong:font-medium
          prose-a:text-copper-600 prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-copper-700
          prose-blockquote:border-l-copper-400 prose-blockquote:bg-warm-100 prose-blockquote:py-1 prose-blockquote:px-6 prose-blockquote:not-italic prose-blockquote:text-warm-800
          prose-hr:border-warm-200
          prose-table:text-warm-800 prose-th:text-warm-900 prose-th:bg-warm-100
          prose-td:border-warm-200
        ">
          <Content />
        </div>
      </div>
    </div>

    <!-- Related services -->
    <section class="py-14 bg-white border-y border-warm-200">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-3xl mx-auto mb-8">
          <h2 class="font-serif text-2xl text-warm-900 font-medium">
            Besoin d'un avis sur un projet concret ?
          </h2>
          <p class="mt-3 text-warm-700 leading-relaxed">
            Ces pages complètent l'article si vous avez une annonce, un certificat ou une pierre précise à vérifier avant achat.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-5">
          {featuredServiceLinks.slice(0, 3).map((service) => (
            <a href={service.href} class="block bg-warm-50 p-6 rounded-2xl border border-warm-200 hover:border-copper-300 hover:shadow-warm transition-all duration-300">
              <h3 class="font-serif text-xl text-warm-900 font-medium">{service.title}</h3>
              <p class="mt-3 text-sm text-warm-700 leading-relaxed">{service.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Back link -->
    <div class="py-12 bg-warm-100 border-t border-warm-200">
      <div class="max-w-3xl mx-auto px-6">
        <a 
          href="/blog" 
          class="group inline-flex items-center text-warm-800 hover:text-copper-700 transition-colors duration-300"
        >
          <svg class="w-4 h-4 mr-2 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Retour aux articles
        </a>
      </div>
    </div>
  </article>

  <!-- CTA -->
  <section class="py-24 bg-warm-900">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="font-serif text-3xl text-cream font-medium">
        Un projet en tête ?
      </h2>
      <p class="mt-6 text-lg text-warm-300 max-w-2xl mx-auto">
        Présentez votre projet et recevez une première réponse sous 48h.
      </p>
      <div class="mt-10">
        <a 
          href="/contact" 
          class="group inline-flex items-center px-8 py-4 text-base font-medium text-warm-900 bg-gradient-to-r from-copper-400 to-copper-500 hover:from-copper-500 hover:to-copper-600 rounded-full transition-all duration-300"
        >
          Présenter mon projet
          <svg class="ml-2 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
