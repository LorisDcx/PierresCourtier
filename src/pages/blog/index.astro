---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { featuredServiceLinks } from '../../data/servicePages';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('fr-FR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}
---

<BaseLayout 
  title="Guides achat pierre précieuse"
  description="Guides pour sécuriser l'achat d'une pierre précieuse : certificats, provenance, traitements, annonces, risques et critères de sélection."
>
  <!-- Hero -->
  <section class="py-24 bg-gradient-to-b from-warm-100 to-cream">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl">
        <span class="inline-block text-sm font-medium text-copper-600 tracking-wider uppercase mb-4">Blog</span>
        <h1 class="font-serif text-4xl md:text-5xl text-warm-900 font-medium leading-tight">
          Guides pour comprendre et sécuriser l'achat de pierres précieuses
        </h1>
        <p class="mt-6 text-xl text-warm-700 leading-relaxed">
          Articles et analyses pour les acheteurs exigeants.
        </p>
      </div>
    </div>
  </section>

  <!-- Paragraphe SEO pilier -->
  <section class="py-12 bg-cream border-b border-warm-200">
    <div class="max-w-4xl mx-auto px-6">
      <p class="text-warm-700 leading-relaxed">
        Ce blog rassemble des guides et analyses destinés aux personnes souhaitant acheter une pierre précieuse en comprenant réellement ce qu'elles regardent. <a href="/blog/comprendre-certificat-gemmologique" class="text-copper-600 hover:text-copper-700 underline underline-offset-2">Certificats gemmologiques</a>, <a href="/blog/provenance-pierres-precieuses" class="text-copper-600 hover:text-copper-700 underline underline-offset-2">provenance</a>, <a href="/blog/traitements-pierres-precieuses" class="text-copper-600 hover:text-copper-700 underline underline-offset-2">traitements</a>, risques liés aux <a href="/blog/acheter-pierre-precieuse-en-ligne" class="text-copper-600 hover:text-copper-700 underline underline-offset-2">achats en ligne</a>, ou encore critères de sélection : chaque article vise à clarifier un sujet précis, sans objectif de vente.
      </p>
      <p class="mt-4 text-warm-700 leading-relaxed">
        Les contenus publiés ici s'adressent à des acheteurs exigeants, souhaitant <a href="/blog/securiser-achat-pierre-precieuse" class="text-copper-600 hover:text-copper-700 underline underline-offset-2">sécuriser leur achat</a> et réduire les zones d'incertitude avant une acquisition. Ils reflètent mon <a href="/comment-je-travaille" class="text-copper-600 hover:text-copper-700 underline underline-offset-2">approche d'accompagnement indépendant</a> : expliquer les limites, poser un cadre clair, et aider à décider en connaissance de cause.
      </p>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-warm-200">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl mb-8">
        <h2 class="font-serif text-2xl text-warm-900 font-medium">
          Aides liées à un projet concret
        </h2>
        <p class="mt-3 text-warm-700 leading-relaxed">
          Si vous avez déjà une annonce, un certificat ou une pierre précise en tête, ces pages sont plus orientées décision que lecture générale.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {featuredServiceLinks.slice(0, 3).map((service) => (
          <a href={service.href} class="block bg-warm-50 p-6 rounded-2xl border border-warm-200 hover:border-copper-300 hover:shadow-warm transition-all duration-300">
            <h3 class="font-serif text-xl text-warm-900 font-medium">{service.title}</h3>
            <p class="mt-3 text-sm text-warm-700 leading-relaxed">{service.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Articles -->
  <section class="py-24 bg-cream">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="font-serif text-2xl text-warm-900 font-medium mb-12">Articles récents</h2>
      {posts.length === 0 ? (
        <p class="text-center text-warm-700">Aucun article pour le moment.</p>
      ) : (
        <div class="grid md:grid-cols-2 gap-8">
          {posts.map((post) => (
            <article class="group bg-white rounded-2xl border border-warm-200 hover:border-copper-300 hover:shadow-warm-lg transition-all duration-300">
              <a href={`/blog/${post.slug}`} class="block p-8">
                {post.data.category && (
                  <span class="inline-block px-3 py-1 text-xs font-medium text-copper-700 bg-copper-100 rounded-full uppercase tracking-wider">
                    {post.data.category}
                  </span>
                )}
                <h3 class="mt-4 font-serif text-2xl text-warm-900 font-medium group-hover:text-copper-700 transition-colors duration-300">
                  {post.data.title}
                </h3>
                <p class="mt-4 text-warm-800 leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>
                <div class="mt-6 flex items-center justify-between">
                  <time class="text-sm text-warm-700" datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span class="text-sm font-medium text-copper-600 group-hover:text-copper-700 transition-colors duration-300 flex items-center gap-2">
                    Lire l'article
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
